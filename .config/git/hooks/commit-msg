#!/usr/bin/env bash
# Hard block: never allow Cursor/AI attribution in commit messages.
set -euo pipefail

msg_file="${1:?}"
[[ -f "$msg_file" ]] || exit 0

if grep -qiE '^(Co-authored-by:.*cursor|Made-with:.*cursor|Made with cursor|Generated by cursor)' "$msg_file"; then
  echo "commit-msg: blocked Cursor/AI attribution in commit message." >&2
  echo "Remove Co-authored-by Cursor / Made-with Cursor trailers and commit again." >&2
  exit 1
fi
