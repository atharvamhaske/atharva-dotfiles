#!/usr/bin/env bash
# Strip Cursor/AI attribution trailers before the commit is recorded.
# Paired with commit-msg (reject if anything remains).
set -euo pipefail

msg_file="${1:?}"
[[ -f "$msg_file" ]] || exit 0

python3 - "$msg_file" <<'PY'
import re
import sys

path = sys.argv[1]
with open(path, encoding="utf-8") as f:
    lines = f.readlines()

blocked = re.compile(
    r"^("
    r"Co-authored-by:\s*.*cursor"
    r"|Made-with:\s*.*cursor"
    r"|Made with cursor"
    r"|Generated by cursor"
    r")",
    re.IGNORECASE,
)

kept = [line for line in lines if not blocked.search(line)]
# Drop trailing blank lines left after stripping trailers.
while kept and kept[-1].strip() == "":
    kept.pop()
if kept and not kept[-1].endswith("\n"):
    kept[-1] += "\n"

with open(path, "w", encoding="utf-8") as f:
    f.writelines(kept)
PY
